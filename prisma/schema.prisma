generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id               String   @id @default(uuid())
  rollNumber       String   @unique
  name             String
  registrationCode String?  @unique // Nullified after registration
  devicePublicKey  String?  // SPKI PEM format string
  isRegistered     Boolean  @default(false)
  records          AttendanceRecord[]
}

model Session {
  id           String   @id @default(uuid())
  date         DateTime @default(now())
  isActive     Boolean  @default(true)
  sessionSecret String  // Used to generate TOTP QR codes
  adminLat     Float?
  adminLng     Float?
  records      AttendanceRecord[]
}

model AttendanceRecord {
  id               String   @id @default(uuid())
  sessionId        String
  studentId        String
  timestamp        DateTime @default(now())
  locationVerified Boolean  @default(false)
  
  session Session @relation(fields: [sessionId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@unique([sessionId, studentId]) // Prevent duplicate submissions per session
}
